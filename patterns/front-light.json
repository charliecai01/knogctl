{
  "_comment": [
    "Cobber Mini Front (prodcode 4). Verified against hardware.",
    "Mode 3 runs this light REARWARD as a fallback only - white to the rear",
    "is very likely illegal and relies on your red reflector for the colour",
    "cue. Use it when you have forgotten the rear light, not by default."
  ],
  "design": {
    "status": "verified device, corrected status bytes",
    "target": "Cobber Mini Front (prodcode 4), 2 channels",
    "notes": [
      "status base is 0x01 on this model (the rear uses 0x03)",
      "bit3/bit4 set per mode so the button LED distinguishes them",
      "bit2 (skip mode) deliberately clear on all modes",
      "only ch1 and ch2 exist on this model"
    ]
  },
  "device": {
    "prodcode": 4,
    "name": "Cobber Mini Front (Cobber Front (Small))",
    "channels": 2
  },
  "modes": [
    {
      "index": 1,
      "name": "Approach",
      "purpose": "default daylight, forward-facing",
      "delays": {
        "short": 20,
        "long": 180
      },
      "est_runtime_hr": "3.5-4",
      "status": "0x09",
      "steps": [
        "0xEC flash A 7/7",
        "0x2C dip 1/7",
        "0xEC flash B 7/7",
        "0x5C floor 2/7 - gap-acceptance cue"
      ]
    },
    {
      "index": 2,
      "name": "Dawn Steady",
      "purpose": "dark or twilight, forward-facing; deliberately not flashing",
      "delays": {
        "short": 150,
        "long": 150
      },
      "est_runtime_hr": "~2",
      "status": "0x11",
      "steps": [
        "0xBC constant 5/7 (~85 lm)"
      ]
    },
    {
      "index": 3,
      "name": "Backup Rear",
      "purpose": "FALLBACK: this light used rearward when the rear light is absent",
      "delays": {
        "short": 20,
        "long": 200
      },
      "est_runtime_hr": "~8",
      "status": "0x19",
      "steps": [
        "0x8C flash A 4/7 (~68 lm, capped to avoid dazzling followers)",
        "0x2C dip 1/7",
        "0x8C flash B 4/7",
        "0x3C floor 1/7"
      ]
    }
  ],
