{
  "_comment": [
    "PROPOSAL - not written to any device, and PROVISIONAL: the front light",
    "has not been connected yet, so its channel behaviour is unverified.",
    "",
    "WARNING: a white light facing rearward is very likely illegal where you",
    "ride (red to rear is near-universal) and can cause drivers to misjudge",
    "your direction of travel. See docs/PATTERN-DESIGN.md."
  ],
  "design": {
    "status": "proposal - unverified against hardware",
    "target": "Cobber Mini Front (prodcode 4) mounted facing rearward",
    "unverified": [
      "prodcode 4 is catalogued as 2 channels; ch3/ch4 behaviour unknown",
      "whether the front uses ch4 at peak the way the rear does",
      "delay unit in ms (same open question as the rear)"
    ],
    "why_it_differs_from_the_red_design": [
      "white peaks at 120 lm vs the rear's 75 lm, so the same brightness",
      "number is a much brighter light - floors are lowered accordingly",
      "white dazzles far more than red, so peak is capped in mode 2",
      "2 channels not 3, so the channel mask is ch1-2"
    ]
  },
  "device": {
    "prodcode": 4,
    "name": "Cobber Mini Front (Cobber Front (Small))",
    "channels": 2
  },
  "modes": [
    {
      "index": 1,
      "name": "Daylight Rear-White",
      "purpose": "full daylight, 7-11AM, traffic not close behind",
      "delays": {
        "short": 20,
        "long": 150
      },
      "est_runtime_hr": "5-6",
      "steps": [
        {
          "byte": "0xEC",
          "brightness": 7,
          "delay": "short",
          "channels": [
            1,
            2
          ],
          "note": "flash A, full output"
        },
        {
          "byte": "0x2C",
          "brightness": 1,
          "delay": "short",
          "channels": [
            1,
            2
          ],
          "note": "dip - never fully dark"
        },
        {
          "byte": "0xEC",
          "brightness": 7,
          "delay": "short",
          "channels": [
            1,
            2
          ],
          "note": "flash B - doublet"
        },
        {
          "byte": "0x3C",
          "brightness": 1,
          "delay": "long",
          "channels": [
            1,
            2
          ],
          "note": "floor one step lower than the red design - white reads brighter"
        }
      ]
    },
    {
      "index": 2,
      "name": "Low-Dazzle",
      "purpose": "twilight, overcast, tunnels, or traffic sitting close behind",
      "delays": {
        "short": 20,
        "long": 150
      },
      "est_runtime_hr": "8+",
      "steps": [
        {
          "byte": "0xAC",
          "brightness": 5,
          "delay": "short",
          "channels": [
            1,
            2
          ],
          "note": "peak capped - white at 7/7 close up is dazzling"
        },
        {
          "byte": "0x2C",
          "brightness": 1,
          "delay": "short",
          "channels": [
            1,
            2
          ],
          "note": "dip"
        },
        {
          "byte": "0xAC",
          "brightness": 5,
          "delay": "short",
          "channels": [
            1,
            2
          ],
          "note": "flash B"
        },
        {
          "byte": "0x3C",
          "brightness": 1,
          "delay": "long",
          "channels": [
            1,
            2
          ],
          "note": "floor kept lit - 1/7 of white is ~17 lm, not dazzling, and preserves ranging"
        }
      ]
    }
  ],
